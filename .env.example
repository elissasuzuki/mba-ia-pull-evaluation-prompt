# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Your LangSmith Hub username
# To find it: publish any prompt on LangSmith Hub, open it and click the lock icon (🔒)
USERNAME_LANGSMITH_HUB=

# ─────────────────────────────────────────────
# LLM Provider Selection
# ─────────────────────────────────────────────
# This project replaces OpenAI with two alternatives:
#   - Ollama: local open-source model runner (no API key required)
#   - Google Gemini: cloud provider, free tier available
#
# Uncomment the block for the provider you want to use.

# --- Option 1: Ollama (local) ---
# Ollama runs models locally. No API key needed.
# Make sure Ollama is running: `ollama serve`
# Recommended model: llama3.2 (install with: ollama pull llama3.2)
#LLM_PROVIDER=ollama
#LLM_MODEL=llama3.2
#EVAL_MODEL=llama3.2
#OLLAMA_BASE_URL=http://localhost:11434

# --- Option 2: Google Gemini (cloud) ---
# Get your API key at: https://aistudio.google.com/app/apikey
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
EVAL_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# --- Option 3: OpenAI (original from challenge, cloud, paid) ---
# Kept for reference. Not used in this implementation.
#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#EVAL_MODEL=gpt-4o
#OPENAI_API_KEY=
